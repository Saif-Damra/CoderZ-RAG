# ------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# .env is git-ignored — do NOT commit real secrets.
# ------------------------------------------------------------------

# ---- Qdrant Cloud (required for the Phase 0 connection check) ----
# Create a free cluster at https://cloud.qdrant.io, then copy the
# cluster URL and an API key below.
QDRANT_URL=https://YOUR-CLUSTER-ID.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=courses

# ---- LLM / generation (needed from Phase 4) ----
# Which provider generates answers: "anthropic" or "openai".
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-...
OPENAI_LLM_MODEL=gpt-4o
# Generation tuning (Phase 4): grounded + concise answers.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=600
LLM_REQUEST_TIMEOUT=60.0

# ---- API (Phase 6) ----
# Comma-separated browser origins allowed to call POST /chat. "*" for local
# dev; set your real frontend origin(s) before deploying, e.g.
# CORS_ALLOW_ORIGINS=https://coderz-tech.com,https://www.coderz-tech.com
CORS_ALLOW_ORIGINS=*

# ---- Embeddings (provider fixed only after the Phase 5 benchmark) ----
# Which provider computes embeddings: "openai", "cohere", or "voyage".
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
# Only needed if you switch EMBEDDING_PROVIDER to one of these for the benchmark:
COHERE_API_KEY=
VOYAGE_API_KEY=

# ---- Chunking + retrieval (safe defaults; tuned in Phase 5) ----
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
